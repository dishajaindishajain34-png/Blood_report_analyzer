# Copy this file to .env and fill in your values

# Roboflow API key (free at roboflow.com) — needed for dataset download
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Kaggle API credentials (optional, for larger datasets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Report branding
INSTITUTE_NAME=AI Blood Report Analyzer
INSTITUTE_SUBTITLE=Automated Preliminary Diagnostic System

# FastAPI server settings
API_HOST=127.0.0.1
API_PORT=8000

# Paths (relative to project root)
YOLO_MODEL_PATH=models/yolov8_blood/best.pt
RESNET_MODEL_PATH=models/resnet50_wbc/wbc_classifier.pth
REPORTS_DIR=reports
